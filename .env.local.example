# ============================================
# NiChAm Trade — ENV Example — MVP + Placeholders
# Root: nicham-trade/.env.local.example
# Copy to .env.local for local: cp .env.local.example .env.local
# ============================================

# --- MVP Placeholders — Escrow + Insurance OFF (No License Risk) ---
# MVP: 8% total (Platform 5% + Sourcing 3%) — No fund holding
# Post-MVP with MTN MoMo license: Flip to true → 10% total
NEXT_PUBLIC_ENABLE_ESCROW=false
NEXT_PUBLIC_ENABLE_INSURANCE=false
NEXT_PUBLIC_ESCROW_FEE=0.01
NEXT_PUBLIC_INSURANCE_FEE=0.01

# --- WhatsApp Placeholders — Separate RFQs ---
# Buyer enters WhatsApp → App sends separate RFQs
NEXT_PUBLIC_AFRICANIES_WA=2347050477950
NEXT_PUBLIC_QIMA_WA=2347050477950
NEXT_PUBLIC_ADMIN_WA=2347050477950

# --- AfricanIES Always Pays Manufacturer Before Pickup ---
# Buyer → Paystack split directly to AfricanIES wallet → AfricanIES pays factory before pickup
# Platform never holds fund in MVP → No escrow license needed
NEXT_PUBLIC_AFRICANIES_PAYS_MANUFACTURER=true

# --- Platform Fees — MVP 5% + 3% ---
NEXT_PUBLIC_PLATFORM_FEE=0.05
NEXT_PUBLIC_SOURCING_FEE=0.03
NEXT_PUBLIC_AFFILIATE_FEE=0.01
NEXT_PUBLIC_FIELD_AGENT_FEE=0.02
NEXT_PUBLIC_FACTORY_VISIT_FEE_NGN=10000

# --- Paystack (MVP) — Direct Split, No Holding ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXX
PAYSTACK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX
NEXT_PUBLIC_PAYSTACK_SPLIT_CODE=SPLIT_XXXXXXXX

# --- MTN MoMo (Post-MVP Placeholder) ---
# NEXT_PUBLIC_MTN_MOMO_API=https://api.mtn.com/momo
# NEXT_PUBLIC_MTN_MOMO_SUBSCRIPTION_KEY=your_key
# NEXT_PUBLIC_ENABLE_MTN_MOMO=false

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NiChAm Trade
NEXT_PUBLIC_CURRENCY=NGN
